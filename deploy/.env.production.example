# Docker image and exposed ports
APP_IMAGE=unilei/aipan-netdisk-search:latest
APP_PORT=3000
WS_PORT=3002

# Runtime concurrency and memory boundaries for a 4-core / 5 GiB host
WEB_CONCURRENCY=2
NODE_MAX_OLD_SPACE_SIZE_MB=320
PM2_MAX_MEMORY_RESTART=384M
APP_MEMORY_LIMIT=1024m
APP_MEMORY_RESERVATION=512m
APP_MEMORY_SWAP_LIMIT=1280m
APP_PIDS_LIMIT=256
MIGRATION_MEMORY_LIMIT=512m
MIGRATION_MEMORY_SWAP_LIMIT=640m
MIGRATION_PIDS_LIMIT=128
BACKUP_MEMORY_LIMIT=256m
BACKUP_MEMORY_SWAP_LIMIT=384m
BACKUP_PIDS_LIMIT=64
POSTGRES_MEMORY_LIMIT=768m
POSTGRES_MEMORY_RESERVATION=256m
POSTGRES_MEMORY_SWAP_LIMIT=1024m
POSTGRES_PIDS_LIMIT=128
REDIS_MEMORY_LIMIT=256m
REDIS_MEMORY_RESERVATION=64m
REDIS_MEMORY_SWAP_LIMIT=384m
REDIS_PIDS_LIMIT=64

# PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aipan
DATABASE_SCHEMA=public
# Optional loopback-only host port for SSH tunnels; never expose it publicly.
POSTGRES_HOST_PORT=5432

# Admin account
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# Runtime security
JWT_SECRET=change-me
SETTINGS_ENCRYPTION_KEY=change-me
REDEMPTION_CODE_HASH_SECRET=change-me

# Redis inside production compose
REDIS_URL=redis://redis:6379

# Scheduled and manual PostgreSQL backups to Cloudflare R2
DB_BACKUP_IMAGE=unilei/aipan-netdisk-search:db-backup-latest
DB_BACKUP_ENABLED=true
DB_BACKUP_TIME=03:00
DB_BACKUP_RETENTION=10
DB_BACKUP_RUN_ON_STARTUP=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=aipan/postgres
R2_ENDPOINT=
TZ=Asia/Shanghai

# Elasticsearch lives on an independent VPS.
# The app connects over HTTPS with Basic Auth and CA fingerprint verification.
ELASTICSEARCH_NODE=https://your-es-host:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me
ELASTICSEARCH_CA_FINGERPRINT=AA:BB:CC:DD
ELASTICSEARCH_USER_RESOURCE_INDEX=user-resources

# Auto review after users submit or update UserResource
USER_RESOURCE_AUTO_REVIEW_ENABLED=true
USER_RESOURCE_AUTO_REVIEW_APPROVE_VALID=true
USER_RESOURCE_AUTO_REVIEW_REJECT_INVALID=true
USER_RESOURCE_AUTO_REVIEW_REQUIRE_REACHABLE=false
USER_RESOURCE_AUTO_REVIEW_NOTIFY_USER=true
USER_RESOURCE_AUTO_REVIEW_NOTIFY_EMAIL=true
USER_RESOURCE_REVIEW_EMAIL_THROTTLE_ENABLED=true
USER_RESOURCE_REVIEW_EMAIL_THROTTLE_SECONDS=86400
USER_RESOURCE_AUTO_REVIEW_MAX_LINKS=5
USER_RESOURCE_AUTO_REVIEW_QUEUE_ENABLED=true
USER_RESOURCE_AUTO_REVIEW_QUEUE_MODE=auto
USER_RESOURCE_AUTO_REVIEW_WORKER_ENABLED=true
USER_RESOURCE_AUTO_REVIEW_WORKER_CONCURRENCY=2
USER_RESOURCE_AUTO_REVIEW_QUEUE_MAX_RETRIES=3
USER_RESOURCE_AUTO_REVIEW_QUEUE_RETRY_DELAY_MS=30000
USER_RESOURCE_AUTO_REVIEW_QUEUE_POLL_INTERVAL_MS=2000
USER_RESOURCE_AUTO_REVIEW_QUEUE_DEDUPE_TTL_SECONDS=3600

# PanSou source for /api/sources/pansou.
# For a separately managed PanSou container, connect it to the app Docker network
# and keep the container name or network alias as `pansou`.
PANSOU_API_URLS=http://pansou:8888/api/search
PANSOU_AUTH_TOKEN=
# Leave empty to let PanSou return all supported cloud/link types.
PANSOU_CLOUD_TYPES=
PANSOU_PLUGINS=
PANSOU_CHANNELS=
PANSOU_RESULT_MODE=merge
PANSOU_SOURCE_MODE=all
PANSOU_REFRESH=false
PANSOU_REQUEST_TIMEOUT_MS=15000
PANSOU_MAX_RESULTS=300

# Optional GitHub image/resource storage
NUXT_PUBLIC_GITHUB_OWNER=
NUXT_PUBLIC_GITHUB_REPO=
NUXT_PUBLIC_GITHUB_TOKEN=
NUXT_PUBLIC_GITHUB_BRANCH=master

# Optional Quark integration
NUXT_PUBLIC_QUARK_COOKIE=
